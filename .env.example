DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=UTC

# Leave DB_ENGINE unset to use the local db.sqlite3 file.
# For PostgreSQL, set DB_ENGINE=postgres and configure these values.
# DB_ENGINE=postgres
# DB_NAME=event_registration
# DB_USER=event_app
# DB_PASSWORD=change-this-password
# DB_HOST=localhost
# DB_PORT=5432
